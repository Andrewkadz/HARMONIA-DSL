+        # Expected: (5.0 + 10.0) * (1 - 1.5) = 15.0 * (-0.5) = -7.5
+        expected = (5.0 + 10.0) * (1 - 1.5)
+        assert abs(context.state.stabilized_value - expected) < 1e-6
