+        context.state.phi_state = 1e-10
+        context.state.epsilon_drift = 1e-10
+        
+        interpreter.coexist(None, context)
+        
+        expected = (1e-10 + 1e-10) * (1 - 1e-10)
+        assert abs(context.state.stabilized_value - expected) < 1e-15
+
+
+if __name__ == "__main__":
